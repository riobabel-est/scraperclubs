# Proteger acceso directo a la base de datos
<FilesMatch "\.(db|sqlite|sqlite3|sql|log|env|ini|json)$">
    Require all denied
</FilesMatch>

# Bloquear acceso a la carpeta data/ (stats.db)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^data/ - [F,L]
    RewriteRule ^cli/ - [F,L]
    # Bloquear acceso directo a la clave maestra de cifrado
    RewriteRule ^inc/secret\.php$ - [F,L]
</IfModule>

# Desactivar listado de directorios
Options -Indexes

# Proteger archivos sensibles
<FilesMatch "^(enviar_smtp_random\.php|cron\.php)$">
    Require all denied
</FilesMatch>

# Bloquear acceso directo a la clave maestra de cifrado (inc/secret.php)
<FilesMatch "^(secret\.php)$">
    Require all denied
</FilesMatch>
