# Proteger acceso directo a la base de datos
<FilesMatch "\.(db|sqlite|sqlite3|sql|log|env|ini|json)$">
    Require all denied
</FilesMatch>

# Bloquear acceso a la carpeta data/ (stats.db)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^data/ - [F,L]
    RewriteRule ^cli/ - [F,L]
    # Bloquear acceso directo a la clave maestra de cifrado
    RewriteRule ^inc/secret\.php$ - [F,L]
</IfModule>

# Desactivar listado de directorios
Options -Indexes

# Proteger archivos sensibles
<FilesMatch "^(enviar_smtp_random\.php|cron\.php)$">
    Require all denied
</FilesMatch>

# Bloquear acceso directo a la clave maestra de cifrado (inc/secret.php)
<FilesMatch "^(secret\.php)$">
    Require all denied
</FilesMatch>

# ─── ANTI-CACHÉ dinámico (2026-08-27) ─────────────────────────────────────────
# Todo el PHP del outbound es 100% dinámico (colas, envíos, KPIs). El Dynamic
# Cache de SiteGround cacheó URLs con query string y sirvió colas obsoletas
# (leads ya enviados volvían a salir). Se fuerza no-cache a nivel de servidor
# (redundante con los headers que ya emiten get_cola.php y enviar_lote.php).
<IfModule mod_headers.c>
    <FilesMatch "\.php$">
        Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
</IfModule>

